[database]
data_dir   = "{{ srdb_data_dir }}/pgdata"
socket_dir = "{{ srdb_data_dir }}"

[worker]
github_tokens = {{ github_tokens | tojson }}

[server]
host = "0.0.0.0"
port = {{ srdb_server_port }}

[logging]
file  = "{{ srdb_data_dir }}/app.log"
level = "INFO"
{% if sentry_dsn %}sentry_dsn = "{{ sentry_dsn }}"{% endif %}

[auth]
github_client_id     = "{{ github_client_id }}"
github_client_secret = "{{ github_client_secret }}"
base_url             = "{{ srdb_base_url }}"
